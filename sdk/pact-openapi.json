{
  "openapi": "3.1.0",
  "info": {
    "title": "Pact",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Index",
        "description": "Serves the Pact demo UI.",
        "operationId": "index__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness probe. Reports the process is up, the mode (demo or PayPal sandbox), and the payment rails in use.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "summary": "Ready",
        "description": "Readiness probe, separate from health. Returns 200 only when the startup config validates and the database passes a write/read probe. Deploys gate on this endpoint.",
        "operationId": "ready_api_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/scenarios": {
      "get": {
        "summary": "Scenarios",
        "description": "Lists the 14 deal scenarios with their candidate acceptance checks, price bounds, and seller agents.",
        "operationId": "scenarios_api_scenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/agents": {
      "get": {
        "summary": "Agents",
        "description": "Lists the buyer and seller agents with their reputation scores and deal counts.",
        "operationId": "agents_api_agents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/deals": {
      "post": {
        "summary": "Create Deal",
        "description": "Creates a deal from a scenario: sets the price bounds and bond percent, then the buyer and seller agents negotiate and freeze the contract. Procurement deals ground the bounds in live Channel3 market data first.",
        "operationId": "create_deal_api_deals_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDealRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/deals/{deal_id}": {
      "get": {
        "summary": "Get Deal",
        "description": "Returns one deal: state, frozen spec with the SHA-256 contract hash, money legs, ledger events, and settlement progress.",
        "operationId": "get_deal_api_deals__deal_id__get",
        "parameters": [
          {
            "name": "deal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Deal Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/deals/{deal_id}/dispute-packet": {
      "get": {
        "summary": "Dispute Packet",
        "description": "Downloads the self-contained Markdown evidence file for one deal: transcript, frozen spec, check verdicts, reputation moves, and every PayPal transaction id.",
        "operationId": "dispute_packet_api_deals__deal_id__dispute_packet_get",
        "parameters": [
          {
            "name": "deal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Deal Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/deals/{deal_id}/negotiate/run": {
      "post": {
        "summary": "Negotiate",
        "description": "Runs the negotiation for a created deal: the price phase first, then the multi-issue terms phase when the deal was created with multi_issue set.",
        "operationId": "negotiate_api_deals__deal_id__negotiate_run_post",
        "parameters": [
          {
            "name": "deal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Deal Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/deals/{deal_id}/pay": {
      "post": {
        "summary": "Pay",
        "description": "Creates the price order and the bond order and returns the approval links. In demo mode the orders are simulated; in live mode the buyer and seller approve on PayPal.",
        "operationId": "pay_api_deals__deal_id__pay_post",
        "parameters": [
          {
            "name": "deal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Deal Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/deals/{deal_id}/pay/confirm": {
      "post": {
        "summary": "Pay Confirm",
        "description": "Confirms both PayPal orders are approved by the expected sandbox buyer and seller identities, then captures. Refuses capture with a ledger event when a payer does not match. Demo mode skips the check.",
        "operationId": "pay_confirm_api_deals__deal_id__pay_confirm_post",
        "parameters": [
          {
            "name": "deal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Deal Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/deals/{deal_id}/deliver": {
      "post": {
        "summary": "Deliver",
        "description": "Submits the seller delivery text against the frozen contract. A weak delivery spends one revision round instead of settling.",
        "operationId": "deliver_api_deals__deal_id__deliver_post",
        "parameters": [
          {
            "name": "deal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Deal Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeliverRequest",
                "default": {
                  "quality": "auto"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/deals/{deal_id}/verify": {
      "post": {
        "summary": "Verify",
        "description": "Runs the deterministic verifier over the delivery and settles the deal: release payout or refund plus bond slash, recorded leg by leg and resumable after a failure.",
        "operationId": "verify_api_deals__deal_id__verify_post",
        "parameters": [
          {
            "name": "deal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Deal Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/webhooks/paypal": {
      "post": {
        "summary": "Paypal Webhook",
        "description": "Receives PayPal webhook events. Verifies the event signature when a webhook id is configured; events without one are recorded as unverified. Settlement never depends on webhooks.",
        "operationId": "paypal_webhook_webhooks_paypal_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/webhooks": {
      "get": {
        "summary": "Webhook Log",
        "description": "Lists the PayPal webhook events received so far, with their verification status.",
        "operationId": "webhook_log_api_webhooks_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateDealRequest": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id"
          },
          "buyer_max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Buyer Max"
          },
          "seller_floor": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seller Floor"
          },
          "bond_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bond Percent"
          },
          "multi_issue": {
            "type": "boolean",
            "title": "Multi Issue",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "scenario_id"
        ],
        "title": "CreateDealRequest"
      },
      "DeliverRequest": {
        "properties": {
          "quality": {
            "type": "string",
            "title": "Quality",
            "default": "auto"
          }
        },
        "type": "object",
        "title": "DeliverRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}