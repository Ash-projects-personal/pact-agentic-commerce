# Copy this file to .env and fill in your own PayPal sandbox values.
# With every value below left empty, the app runs in demo mode with a
# local payment simulator and says so in the UI and the ledger.

# PayPal sandbox app credentials from the PayPal Developer Dashboard.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox API base URL. This default is the sandbox host.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional. ID of a webhook registered for this app in the PayPal
# Developer Dashboard. When set, webhook signatures are verified with
# PayPal before events are accepted.
PAYPAL_WEBHOOK_ID=

# Sandbox personal account email of the seller. Receives the payment
# payout on a pass and the bond return.
SELLER_SANDBOX_EMAIL=

# Sandbox personal account email of the buyer. Receives the bond payout
# when a bond is slashed. Only used on the fail path.
BUYER_SANDBOX_EMAIL=

# Optional language model layer. Any OpenAI compatible chat endpoint.
# Leave the key empty to run the deterministic engine offline.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Performance bond size as a percent of the agreed price.
BOND_PERCENT=20

# Turso cloud database. When both are set, deals, ledger events, and
# reputation persist in Turso instead of the local SQLite file, so they
# survive a Render restart or spin-down. Leave both empty to use the
# local file. The URL looks like libsql://pact-....turso.io.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Abuse limits. Demo-grade protection against accidental floods. A
# value of 0 disables that cap. The counters live in memory and reset
# on restart.
# Deals created per minute from one client address.
PACT_MAX_DEALS_PER_MINUTE_PER_IP=30
# Deals created per minute across all clients.
PACT_MAX_DEALS_PER_MINUTE_GLOBAL=120
# Length of the rate window in seconds.
PACT_RATE_WINDOW_SECONDS=60
# Request body size cap in bytes on the negotiation and delivery
# endpoints. Oversized bodies are rejected with a 413.
PACT_MAX_REQUEST_BYTES=65536
